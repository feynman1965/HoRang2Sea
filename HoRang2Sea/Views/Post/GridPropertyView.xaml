<UserControl x:Class="HoRang2Sea.Views.GridPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HoRang2Sea.Views"
             xmlns:vm="clr-namespace:HoRang2Sea.ViewModels"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Column="0" Grid.Row="0"
               Content="Global Items  (더블클릭 → 추가/제거, ✓=추가됨)" Foreground="Gray" FontSize="14"/>
        <Label Grid.Column="1" Grid.Row="0"
               Content="This Items  (더블클릭 → 제거)" Foreground="Gray" FontSize="14"/>

        <!-- DevExpress TextEdit 사용 -->
        <dxe:TextEdit Grid.Column="0" Grid.Row="1" Margin="5" Height="25"
                      Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                      NullText="Search Global Items..." />

        <!-- Global Items: 컴포넌트 트리 (접두어 그룹화). 잎(변수) 더블클릭 → This Items 추가/제거 -->
        <TreeView Grid.Column="0" Grid.Row="2" Margin="5"
                  ItemsSource="{Binding GroupedGridGlobalItems}"
                  MouseDoubleClick="GlobalTree_MouseDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  BorderBrush="#D0D0D0" BorderThickness="1"
                  ToolTip="컴포넌트별로 묶인 변수입니다. 변수를 더블클릭하면 우측 목록에 추가됩니다.">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <HierarchicalDataTemplate DataType="{x:Type vm:ChartVariableGroup}" ItemsSource="{Binding Items}">
                    <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="#444444"/>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type vm:ChartVariableItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="✓" Foreground="#1E8449" FontWeight="Bold"
                                   Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- This Items: 더블클릭 → 제거 -->
        <dxe:ListBoxEdit x:Name="ThisItemsList" ItemsSource="{Binding GridItems}" Grid.Column="1" Grid.Row="2" Margin="5"
                         MouseDoubleClick="ThisItems_MouseDoubleClick"
                         dx:ListBoxDragDropBehavior.AllowDragDrop="True"
                         dx:ListBoxDragDropBehavior.DragRecordOver="OnDragRecordOver" />
    </Grid>
</UserControl>
