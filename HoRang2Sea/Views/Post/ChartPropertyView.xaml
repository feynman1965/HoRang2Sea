<UserControl x:Class="HoRang2Sea.Views.ChartPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HoRang2Sea.Views"
             xmlns:vm="clr-namespace:HoRang2Sea.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Labels -->
        <Label Grid.Column="0" Grid.Row="0"
               Content="Global Items  (더블클릭→Y, 우클릭→X)" Foreground="Gray" FontSize="14"/>
        <Label Grid.Column="1" Grid.Row="0"
               Content="X Axis Item  (더블클릭 → 제거)" Foreground="Gray" FontSize="14"/>

        <!-- Search Box under Global Items -->
        <dxe:TextEdit Grid.Column="0" Grid.Row="1" Margin="5"
                      Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                      NullText="Search..."/>

        <!-- Global Items: 컴포넌트 트리. 잎 더블클릭 → Y축 추가, 우클릭 → X축으로 지정 -->
        <TreeView Grid.Column="0" Grid.Row="2" Grid.RowSpan="3" Margin="5"
                  ItemsSource="{Binding GroupedChartGlobalItems}"
                  MouseDoubleClick="GlobalTree_MouseDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  BorderBrush="#D0D0D0" BorderThickness="1"
                  ToolTip="변수 더블클릭 → Y축 추가 / 우클릭 → X축으로 지정">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:ChartVariableGroup}" ItemsSource="{Binding Items}">
                    <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="#444444"/>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock Text="{Binding}">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="X축으로 지정" Click="SetX_Click"/>
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- X Axis ListBox (1개) -->
        <dxe:ListBoxEdit x:Name="XItemsList" ItemsSource="{Binding ChartXItems}" Grid.Column="1" Grid.Row="2" Margin="5"
                         MouseDoubleClick="XItemsList_MouseDoubleClick"
                         dx:ListBoxDragDropBehavior.AllowDragDrop="True"
                         dx:ListBoxDragDropBehavior.DragRecordOver="OnXDragRecordOver" />

        <!-- Y Axis Label -->
        <Label Grid.Column="1" Grid.Row="3"
               Content="Y Axis Item  (더블클릭 → 제거)" Foreground="Gray" FontSize="14"/>

        <!-- Y Axis ListBox -->
        <dxe:ListBoxEdit x:Name="YItemsList" ItemsSource="{Binding ChartYItems}" Grid.Column="1" Grid.Row="4" Margin="5"
                         MouseDoubleClick="YItemsList_MouseDoubleClick"
                         dx:ListBoxDragDropBehavior.AllowDragDrop="True"
                         dx:ListBoxDragDropBehavior.DragRecordOver="OnYDragRecordOver" />
    </Grid>
</UserControl>
