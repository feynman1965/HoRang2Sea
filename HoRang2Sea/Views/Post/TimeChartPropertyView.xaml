<UserControl x:Class="HoRang2Sea.Views.TimeChartPropertyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:local="clr-namespace:HoRang2Sea.Views"
             xmlns:vm="clr-namespace:HoRang2Sea.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Global Items 레이블 (더블클릭 토글: 추가/제거, ✓=추가됨) -->
        <Label  Grid.Column="0" Grid.Row="0"
                Content="Global Items  (double-click → add/remove, ✓=added)" Foreground="Gray" FontSize="14"/>

        <!-- 검색어 입력 -->
        <dxe:TextEdit Grid.Column="0" Grid.Row="1" Margin="5" Height="25"
                      Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                      NullText="Search Global Items..." />

        <!-- Global Items: 컴포넌트 트리 (접두어 그룹화). 잎(변수) 더블클릭 → Y축 추가 -->
        <TreeView Grid.Column="0" Grid.Row="2" Grid.RowSpan="3" Margin="5"
                  ItemsSource="{Binding GroupedChartGlobalItems}"
                  MouseDoubleClick="GlobalTree_MouseDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  BorderBrush="#D0D0D0" BorderThickness="1"
                  ToolTip="Variables grouped by component. Double-click a variable to add it to the Y axis list on the right.">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <HierarchicalDataTemplate DataType="{x:Type vm:ChartVariableGroup}" ItemsSource="{Binding Items}">
                    <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="#444444"/>
                </HierarchicalDataTemplate>
                <DataTemplate DataType="{x:Type vm:ChartVariableItem}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="✓" Foreground="#1E8449" FontWeight="Bold"
                                   Visibility="{Binding IsAdded, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- Y Axis Item 레이블 (더블클릭으로 제거) -->
        <Label  Grid.Column="1" Grid.Row="0"
                Content="Y Axis Item  (double-click → remove)" Foreground="Gray" FontSize="14"/>

        <!-- Y Axis Items 리스트 -->
        <dxe:ListBoxEdit x:Name="YItemsList" ItemsSource="{Binding ChartYItems}"
                         Grid.Column="1" Grid.Row="1" Grid.RowSpan="4"  Margin="5"
                         MouseDoubleClick="YItemsList_MouseDoubleClick"
                         dx:ListBoxDragDropBehavior.AllowDragDrop="True"
                         dx:ListBoxDragDropBehavior.DragRecordOver="OnYDragRecordOver" />

    </Grid>
</UserControl>
