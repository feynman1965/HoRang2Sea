<UserControl 
    x:Class="HoRang2Sea.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" 
    xmlns:ViewModels="clr-namespace:HoRang2Sea.ViewModels"
    xmlns:local="clr-namespace:HoRang2Sea.Views" 
    xmlns:services="clr-namespace:HoRang2Sea.Services" 
    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars" 
    xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking" 
    xmlns:p1="clr-namespace:HoRang2Sea.Services"
    xmlns:dxr="http://schemas.devexpress.com/winfx/2008/xaml/ribbon" 
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" 
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" 
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300" x:Name="myCustomControl"
    Loaded="myCustomControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HoRang2Sea;component/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
          
            <Style x:Key="myGlyphStyle" TargetType="Image">
                <Setter Property="Height" Value="20"/>
                <Setter Property="Width" Value="20"/>
            </Style>
            <Style x:Key="myGlyphStyle30" TargetType="Image">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Width" Value="30"/>
            </Style>

            <ControlTemplate x:Key="HomeControlPaneTemplate" TargetType="{x:Type ContentControl}">
                <Grid Margin="40,0,30,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 좌상단 브랜드 락업 (타이틀바와 중복되는 대형 배너 대신 작게) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,24,0,0">
                        <Image Source="{dx:SvgImageSource Uri='/HoRang2Sea;component/Resource/tigerh2icon.svg'}" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="HoRang2 Sea" FontSize="26" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Getting started: Home의 핵심 콘텐츠 -->
                    <Border Grid.Row="1" Margin="0,22,0,0" Padding="20,16" CornerRadius="8" Background="#F5F7FA" BorderBrush="#E1E7EA" BorderThickness="1" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Getting started" FontSize="15" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                            <TextBlock Foreground="#566573" FontSize="13.5" TextWrapping="Wrap" LineHeight="24">
                                <Run Text="•  "/><Run Text="New" FontWeight="SemiBold"/><Run Text=" — create a vehicle model."/><LineBreak/>
                                <Run Text="•  "/><Run Text="Saved" FontWeight="SemiBold"/><Run Text=" — open or manage configurations you saved by name."/><LineBreak/>
                                <Run Text="•  "/><Run Text="History" FontWeight="SemiBold"/><Run Text=" — recover a recent run (auto-saved, last 20 per model)."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </ControlTemplate>

            <!-- ===== Config row look (Saved/History 공용 시각 정의는 각 템플릿에 인라인) ===== -->
            <ControlTemplate x:Key="SavedConfigsControlPaneTemplate" TargetType="{x:Type ContentControl}">
                <Grid Margin="40,0,30,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Saved Configurations" FontSize="32" FontFamily="Segoe UI Light" Margin="0,18,0,4" Foreground="#2C3E50"/>
                    <TextBlock Grid.Row="1" Text="Open or delete configurations you saved by name. (Save from a model's ribbon → Save Config.)" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding SavedConfigs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding TypeName}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="2,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2" Padding="12,9">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#E6E9ED"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F4F9FD"/>
                                                                        <Setter Property="BorderBrush" Value="#9BC4E2"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <dxmvvm:Interaction.Behaviors>
                                                            <dxmvvm:EventToCommand EventName="MouseLeftButtonUp" Command="{Binding DataContext.OpenSavedConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}"/>
                                                        </dxmvvm:Interaction.Behaviors>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <dx:DXImage Grid.Column="0" Source="{dx:DXImage SvgImages/DiagramIcons/save.svg}" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#222222" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SavedDate}" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                                            <Button Grid.Column="3" Cursor="Hand" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Delete"
                                                                    Command="{Binding DataContext.DeleteConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bd" CornerRadius="13" Background="Transparent">
                                                                            <TextBlock x:Name="x" Text="✕" FontSize="12" Foreground="#B0B7BD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="#FDE8E8"/>
                                                                                <Setter TargetName="x" Property="Foreground" Value="#E74C3C"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="HistoryControlPaneTemplate" TargetType="{x:Type ContentControl}">
                <Grid Margin="40,0,30,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="History" FontSize="32" FontFamily="Segoe UI Light" Margin="0,18,0,4" Foreground="#2C3E50"/>
                    <TextBlock Grid.Row="1" Text="Automatically captured each time you Run a simulation (latest 20 per model). Click to restore, or delete." FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding HistoryConfigs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding TypeName}" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="2,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2" Padding="12,9">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#E6E9ED"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F4F9FD"/>
                                                                        <Setter Property="BorderBrush" Value="#9BC4E2"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <dxmvvm:Interaction.Behaviors>
                                                            <dxmvvm:EventToCommand EventName="MouseLeftButtonUp" Command="{Binding DataContext.OpenSavedConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}"/>
                                                        </dxmvvm:Interaction.Behaviors>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <dx:DXImage Grid.Column="0" Source="{dx:DXImage SvgImages/Actions/Open2.svg}" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#222222" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SavedDate}" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                                            <Button Grid.Column="3" Cursor="Hand" Width="26" Height="26" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Delete"
                                                                    Command="{Binding DataContext.DeleteConfigCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bd" CornerRadius="13" Background="Transparent">
                                                                            <TextBlock x:Name="x" Text="✕" FontSize="12" Foreground="#B0B7BD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bd" Property="Background" Value="#FDE8E8"/>
                                                                                <Setter TargetName="x" Property="Foreground" Value="#E74C3C"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ControlTemplate>


            <ControlTemplate x:Key="NewControlPaneTemplate" TargetType="{x:Type ContentControl}">
                <Grid Margin="40,0,40,0">
                    <Grid.Background>
                        <ImageBrush ImageSource="pack://application:,,,/HoRang2Sea;component/Resource/MainImage.png" Stretch="Uniform"/>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="250"/>
                    </Grid.RowDefinitions>
                    
                    
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="New" FontSize="32" FontFamily="Segoe UI Light" Margin="0,18,0,4" Foreground="#2C3E50"/>
                        <TextBlock Text="Select a vessel to create a new simulation model." FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,14"/>
                    </StackPanel>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ProjectViewModels}" Margin="0 30 0 0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ViewModels:ProjectViewModel}">
                                <Button Style="{StaticResource BackstageContentButtonStyle}" Padding="30,15,30,15" Margin="5" Command="{Binding ElementName=myCustomControl, Path=DataContext.CreatDocumentCommand}"
                                        CommandParameter="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border  x:Name ="MyBorder"  BorderThickness="1" BorderBrush="LightGray" Width="150" Height="160">
                                                <Border.Background>
                                                    <SolidColorBrush x:Name="myAnimatedBrush" Color="White" />
                                                </Border.Background>
                                                <Grid>
                                                    <dx:DXImage x:Name="MyImage" Source="{Binding Image}" RenderSize="20,20" Margin="25 50" dxb:ImageColorizer.Color="Gray"/>
                                                    <Label Content="{Binding Name}"  Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation  Storyboard.TargetName="MyImage"  Storyboard.TargetProperty="Margin" Duration="0:0:0.4" FillBehavior="Stop" From="1 50 49 50" To="25 50" />
                                                            <ColorAnimation Storyboard.TargetName="myAnimatedBrush" Storyboard.TargetProperty="Color" To="AliceBlue"  Duration="0:0:0.4" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ColorAnimation Storyboard.TargetName="myAnimatedBrush" Storyboard.TargetProperty="Color" To="White"  Duration="0:0:0.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                </Grid>
            </ControlTemplate>
            
            
            <ControlTemplate x:Key="SettingsControlPaneTemplate" TargetType="{x:Type ContentControl}">
                <StackPanel Margin="40,0,40,0">
                    <TextBlock Style="{StaticResource PageHeaderStyle}" Text="Settings" />

                    <TextBlock Text="Result Recording" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#555555" FontSize="13" Margin="0,0,0,10"
                               Text="How often simulation results are stored for charts and CSV export. One simulation step is 1 ms, so 100 steps = 0.1 s. A smaller interval keeps more detail but uses much more memory on long runs."/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Interval" VerticalAlignment="Center" FontSize="14" Width="70"/>
                        <dxe:ComboBoxEdit Width="210" IsTextEditable="False" VerticalAlignment="Center"
                                          SelectedIndex="{Binding RecordIntervalIndex, Mode=TwoWay}">
                            <dxe:ComboBoxEditItem Content="0.01 s  (10 steps)"/>
                            <dxe:ComboBoxEditItem Content="0.1 s  (100 steps)  — default"/>
                            <dxe:ComboBoxEditItem Content="0.5 s  (500 steps)"/>
                            <dxe:ComboBoxEditItem Content="1 s  (1000 steps)"/>
                        </dxe:ComboBoxEdit>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Foreground="#8A6D3B" FontSize="12.5" Margin="0,12,0,0"
                               Text="{Binding RecordIntervalHint}"/>

                    <TextBlock TextWrapping="Wrap" Foreground="#777777" FontSize="12" Margin="0,16,0,0"
                               Text="Takes effect from the next simulation run. The setting is stored per user."/>
                </StackPanel>
            </ControlTemplate>

            <ControlTemplate x:Key="InfoControlPaneTemplate" TargetType="{x:Type ContentControl}">
                <StackPanel Margin="40,0,0,0">
                    <TextBlock Style="{StaticResource PageHeaderStyle}" Text="About" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        <MediaElement Grid.Row="0" Name="myMediaElement" Source="InfoMovie.mp4" LoadedBehavior="Play"  Margin="10,10,50,50" Visibility="Visible" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" >
                        </MediaElement>
                        <!--
                            <MediaElement.Triggers>
                                <EventTrigger RoutedEvent="MediaElement.Loaded">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <MediaTimeline Source="InfoMovie.mp4" Storyboard.TargetName="myMediaElement" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </MediaElement.Triggers>
                            -->
                       
                    </Grid>
                </StackPanel>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <dxr:RibbonControl x:Name="RibbonControl" 
                           ShowApplicationButton ="True"
                           ApplicationButtonText ="Home"
                           ApplicationButtonLargeIcon="/HoRang2Sea;component/Resource/tigerh2icon.svg"
                           PageCategoryAlignment="Right"
                           RibbonTitleBarVisibility="Visible"
                           RibbonStyle="Office2019"
                           ToolbarShowMode="Default"
                           IsSimplified="True"
                           
                           >
            <dxmvvm:Interaction.Behaviors>
                <services:BackstageViewService/>
                <dxmvvm:EventToCommand EventName="BackstageOpened" Command="{Binding BackstageOpenedCommand}" />
            </dxmvvm:Interaction.Behaviors>
            <dxr:RibbonControl.ApplicationMenu>
                <dxr:BackstageViewControl CloseButtonVisibility="Collapsed" >
                    <dxr:BackstageViewControl.TabPaneStyle>
                        <Style TargetType="dxr:BackstageViewLeftPartContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                            <Grid>
                                            <Border CornerRadius="20">
                                                <Image Source="/Resource/startpage.png" Grid.RowSpan="2"  HorizontalAlignment="Stretch" VerticalAlignment="Top"   Stretch="None" Width="250" />
                                            </Border>
                                            <!-- 탭 라벨(흰색) 가독성용 어두운 스크림: 위는 이미지 보이게 약하게, 아래로 갈수록 진하게(밝은 노랑 영역 덮음) -->
                                            <Border CornerRadius="20">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#26263238" Offset="0"/>
                                                        <GradientStop Color="#73263238" Offset="0.45"/>
                                                        <GradientStop Color="#D91B2A33" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <ContentControl Content="{Binding}" />
                                            </Grid>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </dxr:BackstageViewControl.TabPaneStyle>
                    <dxr:BackstageButtonItem Margin="0 30" 
                                             Glyph="{iconPacks:FontAwesomeImage Kind=ArrowAltCircleLeftRegular, Brush=White}" GlyphStyle="{StaticResource myGlyphStyle30}" Placement="Top"/>
                    
                    <dxr:BackstageTabItem Content="Home"  FontSize="15" Margin="0 5" FontWeight="Bold"
                                          Glyph="{iconPacks:JamIconsImage Kind=Home ,Brush=White}" GlyphStyle="{StaticResource myGlyphStyle}">
                        <dxr:BackstageTabItem.ControlPane>
                            <ContentControl Template="{StaticResource HomeControlPaneTemplate}" SnapsToDevicePixels="True" Focusable="False" FocusVisualStyle="{x:Null}" IsTabStop="False" />
                        </dxr:BackstageTabItem.ControlPane>
                    </dxr:BackstageTabItem>
                    
                    <dxr:BackstageTabItem Content="New"  FontSize="15" Margin="0 5" FontWeight="Bold"
                                          Glyph="{iconPacks:ForkAwesomeImage Kind=FileOutline, Brush=White}" GlyphStyle="{StaticResource myGlyphStyle}" >
                        <dxr:BackstageTabItem.ControlPane>
                            <ContentControl Template="{StaticResource NewControlPaneTemplate}" SnapsToDevicePixels="True" Focusable="False" FocusVisualStyle="{x:Null}" IsTabStop="False" />
                        </dxr:BackstageTabItem.ControlPane>
                    </dxr:BackstageTabItem>

                    <dxr:BackstageTabItem Content="Saved"  FontSize="15" Margin="0 5" FontWeight="Bold"
                                          Glyph="{iconPacks:FontAwesomeImage Kind=SaveRegular, Brush=White}" GlyphStyle="{StaticResource myGlyphStyle}">
                        <dxr:BackstageTabItem.ControlPane>
                            <ContentControl Template="{StaticResource SavedConfigsControlPaneTemplate}" SnapsToDevicePixels="True" Focusable="False" FocusVisualStyle="{x:Null}" IsTabStop="False" />
                        </dxr:BackstageTabItem.ControlPane>
                    </dxr:BackstageTabItem>

                    <dxr:BackstageTabItem Content="History"  FontSize="15" Margin="0 5" FontWeight="Bold"
                                          Glyph="{iconPacks:FontAwesomeImage Kind=HistorySolid, Brush=White}" GlyphStyle="{StaticResource myGlyphStyle}">
                        <dxr:BackstageTabItem.ControlPane>
                            <ContentControl Template="{StaticResource HistoryControlPaneTemplate}" SnapsToDevicePixels="True" Focusable="False" FocusVisualStyle="{x:Null}" IsTabStop="False" />
                        </dxr:BackstageTabItem.ControlPane>
                    </dxr:BackstageTabItem>
                    <dxr:BackstageSeparatorItem />
                    
                    <dxr:BackstageTabItem Content="Settings" FontSize="15" Margin="0 5" FontWeight="Bold"
                                          Glyph="{iconPacks:FontAwesomeImage Kind=CogSolid, Brush=White}" GlyphStyle="{StaticResource myGlyphStyle}">
                        <dxr:BackstageTabItem.ControlPane>
                            <ContentControl Template="{StaticResource SettingsControlPaneTemplate}" SnapsToDevicePixels="True" Focusable="False" FocusVisualStyle="{x:Null}" IsTabStop="False" />
                        </dxr:BackstageTabItem.ControlPane>
                    </dxr:BackstageTabItem>

                    <dxr:BackstageTabItem Content="About" FontSize="15" Margin="0 5" FontWeight="Bold">
                        <dxr:BackstageTabItem.ControlPane>
                            <ContentControl Template="{StaticResource InfoControlPaneTemplate}" Focusable="False" FocusVisualStyle="{x:Null}" IsTabStop="False"/>
                        </dxr:BackstageTabItem.ControlPane>
                    </dxr:BackstageTabItem>
                    <dxr:BackstageSeparatorItem Placement="Bottom"/>
                    <dxr:BackstageButtonItem Content="Close"  Placement="Bottom"/>
                </dxr:BackstageViewControl>
            </dxr:RibbonControl.ApplicationMenu>
            
            <dxr:RibbonControl.PageHeaderItems>
                <dxb:BarButtonItem Name="bHelp"
                                   Content="❔  Help"
                                   Hint="Show the step-by-step guide"
                                   ItemClick="bHelp_ItemClick"
                                   RibbonStyle="SmallWithText" />
                <dxb:BarItemLink BarItemName="ribbonStyleItem" RibbonStyle="SmallWithText" />
            </dxr:RibbonControl.PageHeaderItems>
        </dxr:RibbonControl>
        
        
        
        <dxdo:DockLayoutManager Grid.Row="1" x:Name="DemoDockContainer" FloatingMode="Desktop" ViewStyle="Light"  ItemsSource="{Binding Workspaces}"
                                    DockingStyle="VS2010" FloatingDocumentContainer="SingleDocument" >
            <dxmvvm:Interaction.Behaviors>
                <p1:DockingSerializationDialogService/>
            </dxmvvm:Interaction.Behaviors>
            <dxdo:LayoutGroup Name="Root">
                <dxdo:LayoutGroup Orientation="Vertical" ItemWidth="3*">
                    <dxdo:LayoutGroup ItemHeight="3*">
                        <dxdo:LayoutGroup Name="Toolbox" DestroyOnClosingChildren="False" ItemWidth="190"/>
                        <dxdo:LayoutGroup ItemWidth="3*" DestroyOnClosingChildren="False">
                            <dxdo:LayoutGroup >
                                <dxdo:DocumentGroup Name="DocumentHost" DestroyOnClosingChildren="False" 
                                                        ClosePageButtonShowMode="InActiveTabPageHeader" Background="Transparent"/>
                            </dxdo:LayoutGroup>
                        </dxdo:LayoutGroup>
                    </dxdo:LayoutGroup>
                    <dxdo:TabbedGroup Name="BottomHost" DestroyOnClosingChildren="False"/>
                </dxdo:LayoutGroup>
                <dxdo:LayoutGroup Name="RightHost" DestroyOnClosingChildren="False" Orientation="Vertical" ItemWidth="290"/>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>

        <!-- 전역 하단 상태바 제거: 각 모델 뷰의 하단 진행 미니바로 대체 (충남대 #5) -->

    </Grid>
</UserControl>
